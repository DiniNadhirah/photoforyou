# Copy to .env for local runs, or add these in Render -> Environment.
SECRET_KEY=change-me-to-a-long-random-string   # SAME value on every instance
INSTANCE_NAME=A                                  # A on the first service, B on the second
STORAGE_BACKEND=supabase                         # or "local" to run without Supabase
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_KEY=YOUR-SERVICE-ROLE-KEY              # Project Settings -> API -> service_role
SUPABASE_BUCKET=vault
SESSION_COOKIE_SECURE=true                       # true on Render (HTTPS)
TRUST_PROXY_HOPS=1
MAX_FILE_MB=50
USER_QUOTA_MB=200
