# =====================================================================
# nginx LOAD BALANCER on Render
# ${UPSTREAM_A_HOST}, ${UPSTREAM_B_HOST}, ${LB_TOKEN} and ${PORT} come
# from the Render environment variables (filled in at container start).
#
# Render free web services can only be reached through their public HTTPS
# address, so each instance gets a small local "bridge" (127.0.0.1:9001,
# 9002) and the upstream pool balances between the bridges.
# =====================================================================
log_format lb '$time_iso8601 client=$remote_addr upstream=$upstream_addr '
              'status=$status upstream_status=$upstream_status '
              'rt=$request_time urt=$upstream_response_time "$request"';
access_log /dev/stdout lb;

# Real client IP from Render's edge proxy
set_real_ip_from 0.0.0.0/0;
real_ip_header X-Forwarded-For;
real_ip_recursive on;

resolver 1.1.1.1 8.8.8.8 valid=60s ipv6=off;

map $request_method $auth_post_key { POST $binary_remote_addr; default ""; }
limit_req_zone $binary_remote_addr zone=req_per_ip:10m   rate=20r/s;
limit_req_zone $auth_post_key      zone=login_per_ip:10m rate=10r/m;
limit_conn_zone $binary_remote_addr zone=conn_per_ip:10m;
limit_req_status 429;
limit_conn_status 429;

proxy_cache_path /var/cache/nginx/static levels=1:2 keys_zone=static_cache:10m
                 max_size=100m inactive=60m use_temp_path=off;

upstream photoforyou_app {
    server 127.0.0.1:9001 max_fails=2 fail_timeout=15s;   # -> instance A
    server 127.0.0.1:9002 max_fails=2 fail_timeout=15s;   # -> instance B
    keepalive 16;
}

# ---- bridge to instance A ------------------------------------------------
server {
    listen 127.0.0.1:9001;
    location / {
        set $target "${UPSTREAM_A_HOST}";
        proxy_pass https://$target;
        proxy_set_header Host $target;
        proxy_ssl_server_name on;
        proxy_ssl_name $target;
        proxy_connect_timeout 5s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        client_max_body_size 60m;
    }
}
# ---- bridge to instance B ------------------------------------------------
server {
    listen 127.0.0.1:9002;
    location / {
        set $target "${UPSTREAM_B_HOST}";
        proxy_pass https://$target;
        proxy_set_header Host $target;
        proxy_ssl_server_name on;
        proxy_ssl_name $target;
        proxy_connect_timeout 5s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        client_max_body_size 60m;
    }
}

# ---- public entrance -------------------------------------------------------
server {
    listen ${PORT};
    client_max_body_size 60m;
    limit_conn conn_per_ip 30;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Client-IP $remote_addr;
    proxy_set_header X-LB-Token "${LB_TOKEN}";
    proxy_connect_timeout 5s;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;

    proxy_next_upstream error timeout http_502 http_503 http_504;
    proxy_next_upstream_tries 2;
    proxy_next_upstream_timeout 15s;

    add_header X-Upstream $upstream_addr always;
    add_header X-Load-Balancer "nginx" always;

    # Friendly page when a visitor is rate limited
    error_page 429 = @too_many;
    location @too_many {
        default_type text/html;
        add_header Retry-After 60 always;
        add_header X-Load-Balancer "nginx" always;
        return 429 '<!doctype html><meta name=viewport content="width=device-width,initial-scale=1"><title>Slow down - PhotoForYou</title><body style="font-family:system-ui,sans-serif;background:#f6f7fb;color:#1e293b;display:grid;place-items:center;min-height:90vh;margin:0"><div style="background:#fff;border:1px solid #e2e8f0;border-radius:14px;padding:32px;max-width:420px"><p style="color:#4f46e5;font-weight:700;font-size:12px;letter-spacing:.08em;margin:0">ERROR 429 - RATE LIMITED BY LOAD BALANCER</p><h1 style="margin:8px 0">Too many requests</h1><p style="color:#64748b">You are sending requests too quickly. Please wait a minute and try again.</p></div>';
    }

    location = /lb-health { access_log off; return 200 "ok\n"; }

    location /static/ {
        proxy_pass http://photoforyou_app;
        proxy_cache static_cache;
        proxy_cache_valid 200 10m;
        add_header X-Cache $upstream_cache_status always;
        add_header X-Upstream $upstream_addr always;
        add_header X-Load-Balancer "nginx" always;
    }

    location ~ ^/(login|register)$ {
        limit_req zone=login_per_ip burst=5 nodelay;
        limit_req zone=req_per_ip burst=40 nodelay;
        proxy_pass http://photoforyou_app;
    }

    location / {
        limit_req zone=req_per_ip burst=40 nodelay;
        proxy_pass http://photoforyou_app;
    }
}
